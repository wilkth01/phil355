---
// The "ask the course bot" block. It links to the bot in BoodleBox and
// offers two or three opening messages to copy. It does not embed the
// bot, call it, or pass anything to it in the address.
//
// With site.botUrl empty, the block says the link is coming and still
// shows the starters.
import { site } from "../site.config";

interface Props {
  /** The line that tells the bot where the student is. It opens every starter. */
  context: string;
  starters: readonly string[];
  /** One line: what AI may be used for on this page's task. */
  rule: string;
}

const { context, starters, rule } = Astro.props;
const hasLink = site.botUrl.trim() !== "";
---

<aside class="askbot" aria-labelledby="askbot-heading">
  <h2 id="askbot-heading">Think it through with the {site.botName}</h2>
  {
    hasLink ? (
      <p>
        <a class="button" href={site.botUrl} target="_blank" rel="noopener noreferrer" data-keep-href>
          Open the {site.botName}
        </a>{" "}
        <span class="fine">Opens BoodleBox in a new tab.</span>
      </p>
    ) : (
      <p class="link-coming">The link to the {site.botName} is coming. These opening messages will work once it is up.</p>
    )
  }
  <p class="fine">
    The bot asks questions; it does not write for you.
    {starters.length > 0 && " Copy an opening message and paste it into the chat:"}
  </p>
  {
    starters.length > 0 && (
      <ul class="starters">
        {starters.map((starter, i) => (
          <li>
            <p class="starter" id={`starter-${i + 1}`}>
              {context} {starter}
            </p>
            <button type="button" class="copy" data-copy={`starter-${i + 1}`} hidden>
              Copy<span class="visually-hidden"> opening message {i + 1}</span>
            </button>
          </li>
        ))}
      </ul>
    )
  }
  <p class="visually-hidden" role="status" id="askbot-status"></p>
  <p class="fine rule">{rule}</p>
</aside>

<script>
  const status = document.getElementById("askbot-status");

  async function copy(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // The clipboard is unavailable (an old browser, or a page not served securely).
      return false;
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(".askbot .copy")) {
    const source = document.getElementById(button.dataset.copy ?? "");
    if (!source) continue;
    button.hidden = false;
    const label = button.innerHTML;
    button.addEventListener("click", async () => {
      const text = (source.textContent ?? "").replace(/\s+/g, " ").trim();
      if (await copy(text)) {
        button.textContent = "Copied";
        if (status) status.textContent = "Copied to the clipboard.";
        setTimeout(() => {
          button.innerHTML = label;
          if (status) status.textContent = "";
        }, 2000);
      } else {
        // Select the text so it can be copied by hand.
        const range = document.createRange();
        range.selectNodeContents(source);
        const selection = getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        if (status) status.textContent = "Could not copy. The message is selected; copy it with your keyboard.";
      }
    });
  }
</script>
