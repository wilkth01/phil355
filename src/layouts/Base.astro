---
import "../styles/global.css";
import { site } from "../site.config";

interface Props {
  /** Page name shown before the site title in the browser tab. Omit on the home page. */
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;

// import.meta.env.BASE_URL may or may not end in a slash; make it end in one.
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-title" href={home}>{site.title}</a>
      <p class="site-term">{site.term}</p>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        {site.instructor.name}, {site.instructor.office}{" "}·{" "}<a href={`mailto:${site.instructor.email}`}>{site.instructor.email}</a>
      </p>
    </footer>
  </body>
</html>
