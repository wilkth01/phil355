---
import "../styles/global.css";
import Fonts from "../components/Fonts.astro";
import { paths } from "../lib/paths";
import { site } from "../site.config";

interface Props {
  /** Page name shown before the site title in the browser tab. Omit on the home page. */
  title?: string;
  description?: string;
  /** True on pages meant to be printed as a handout: reading guides, lab sheets, assignments, the syllabus. */
  handout?: boolean;
}

const { title, description, handout = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;

// import.meta.env.BASE_URL may or may not end in a slash; make it end in one.
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const nav = [
  { href: home, label: "Now" },
  { href: paths.schedule(home), label: "Schedule" },
  { href: paths.cycles(home), label: "Cycles" },
  { href: paths.assignments(home), label: "Assignments" },
  { href: paths.contract(home), label: "Contract" },
  { href: paths.ai(home), label: "AI rules" },
  { href: paths.help(home), label: "Help" },
];
const more = [
  { href: paths.readings(home), label: "Readings" },
  { href: paths.labs(home), label: "Labs" },
  { href: paths.charter(home), label: "Charter" },
  { href: paths.syllabus(home), label: "Syllabus" },
];
const here = Astro.url.pathname.replace(/\/?$/, "/");
// A section's link stays marked on the pages beneath it.
const current = (href: string) => (href === home ? here === home : here.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
    <Fonts />
  </head>
  <body class:list={{ handout }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div>
        <a class="site-title" href={home}>{site.title}</a>
        <p class="site-term">{site.term}</p>
      </div>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <p id="date-preview" class="preview-banner" data-home={home} hidden></p>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="More pages">
        <ul>
          {
            more.map((item) => (
              <li>
                <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p>
        {site.instructor.name}, {site.instructor.office}{" "}·{" "}<a href={`mailto:${site.instructor.email}`}>{site.instructor.email}</a>
      </p>
    </footer>

    <script>
      // When the address carries ?date=YYYY-MM-DD, say so on every page and
      // keep the date on links within the site.
      import { readClock } from "../lib/clock";
      import { formatFull } from "../lib/dates";
      import { site } from "../site.config";

      const clock = readClock(site.timezone, location.search);
      const banner = document.getElementById("date-preview");

      if (banner && (clock.preview || clock.invalid)) {
        const message = clock.preview
          ? `Previewing ${formatFull(clock.today)}. `
          : "The date in the address is not a real date, so this is today’s view. ";
        const back = document.createElement("a");
        back.href = location.pathname;
        back.textContent = clock.preview ? "Back to today" : "Clear it";
        back.dataset.keepHref = "";
        banner.append(message, back);
        banner.hidden = false;
      }

      if (clock.preview) {
        const sitePath = banner?.dataset.home ?? "/";
        document.addEventListener(
          "click",
          (event) => {
            const link = (event.target as Element | null)?.closest?.("a[href]");
            if (!(link instanceof HTMLAnchorElement) || "keepHref" in link.dataset) return;
            const url = new URL(link.href);
            if (url.origin !== location.origin || !url.pathname.startsWith(sitePath)) return;
            if (!url.searchParams.has("date")) {
              url.searchParams.set("date", clock.today);
              link.href = url.toString();
            }
          },
          true,
        );
      }

      // In a list of dated items, mark the next one and mute the ones gone by.
      for (const list of document.querySelectorAll<HTMLElement>("[data-dated]")) {
        let marked = false;
        for (const item of list.querySelectorAll<HTMLElement>("[data-date]")) {
          const date = item.dataset.date ?? "";
          if (date < clock.today) {
            item.classList.add("is-past");
          } else if (!marked) {
            marked = true;
            const badge = document.createElement("span");
            badge.className = "next-badge";
            badge.textContent = date === clock.today ? "Today" : "Next";
            (item.querySelector(".when") ?? item).append(" ", badge);
          }
        }
      }

      // Print buttons.
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-print]")) {
        button.hidden = false;
        button.addEventListener("click", () => window.print());
      }
    </script>
  </body>
</html>
